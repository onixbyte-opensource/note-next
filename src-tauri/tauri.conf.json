{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Note Next",
  "version": "0.1.0",
  "identifier": "com.onixbyte.note-next",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "note-next",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "md", "log", "json"],
        "name": "Text Document",
        "description": "Plain Text File",
        "role": "Editor"
      }
    ]
  }
}
